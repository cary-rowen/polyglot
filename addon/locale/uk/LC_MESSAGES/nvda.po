#: addon\globalPlugins\polyglot\views\settings.py:32 buildVars.py:32
msgid "Polyglot"
msgstr "Поліглот"

#: addon\globalPlugins\polyglot\__init__.py:150
msgid "Enter the translation command layer; press H for command layer help"
msgstr ""
"Відкрити командний шар додатка; натисніть H для отримання довідки щодо "
"командного шару"

#: addon\globalPlugins\polyglot\__init__.py:160
msgid "command layer. Press H for help."
msgstr "командний шар. Натисніть H для отримання довідки."

#. Translators: Input help mode message for exiting the Polyglot command layer.
#: addon\globalPlugins\polyglot\__init__.py:165
msgid "Exit the translation command layer."
msgstr "Вийти з командного шару перекладу."

#: addon\globalPlugins\polyglot\__init__.py:178
msgid "Nothing selected"
msgstr "Нічого не вибрано"

#: addon\globalPlugins\polyglot\__init__.py:183
msgid "Cannot get selected text from the current object"
msgstr "Неможливо отримати вибраний текст із поточного об’єкта"

#: addon\globalPlugins\polyglot\__init__.py:216
msgid "Next source language"
msgstr "Наступна мова оригіналу"

#: addon\globalPlugins\polyglot\__init__.py:220
msgid "Previous source language"
msgstr "Попередна мова оригіналу"

#: addon\globalPlugins\polyglot\__init__.py:224
msgid "Next target language"
msgstr "Наступна мова перекладу"

#: addon\globalPlugins\polyglot\__init__.py:228
msgid "Previous target language"
msgstr "Попередня мова перекладу"

#: addon\globalPlugins\polyglot\__init__.py:239
msgid "Next translation engine"
msgstr "Наступний сервіс перекладу"

#: addon\globalPlugins\polyglot\__init__.py:243
msgid "Previous translation engine"
msgstr "Попередній сервіс перекладу"

#: addon\globalPlugins\polyglot\__init__.py:247
msgid "Swap source and target languages"
msgstr "Поміняти мову оригіналу та мову перекладу"

#: addon\globalPlugins\polyglot\__init__.py:254
msgid "Announce current engine and languages"
msgstr "Повідомити про поточний сервіс перекладу та мови"

#: addon\globalPlugins\polyglot\__init__.py:259
msgid "Copy last translation to clipboard"
msgstr "Копіювати останній переклад у буфер обміну"

#: addon\globalPlugins\polyglot\__init__.py:265
msgid "No translation result to copy"
msgstr "Немає результатів перекладу для копіювання"

#: addon\globalPlugins\polyglot\__init__.py:267
msgid "Open interactive translation dialog"
msgstr "Відкрити інтерактивний діалог перекладу"

#: addon\globalPlugins\polyglot\__init__.py:282
msgid "Open settings"
msgstr "Відкрити налаштування"

#: addon\globalPlugins\polyglot\__init__.py:291
msgid "Toggle auto-translation"
msgstr "Перемикає автоматичний переклад"

#: addon\globalPlugins\polyglot\__init__.py:294
msgid "Auto-translation enabled"
msgstr "Автоматичний переклад увімкнено"

#: addon\globalPlugins\polyglot\__init__.py:294
msgid "Auto-translation disabled"
msgstr "Автоматичний переклад вимкнено"

#: addon\globalPlugins\polyglot\__init__.py:296
#: addon\globalPlugins\polyglot\modelManager\dialog.py:212
msgid "Clear cache"
msgstr "Очистити кеш"

#: addon\globalPlugins\polyglot\__init__.py:299
msgid "Cache cleared"
msgstr "Кеш очищено"

#: addon\globalPlugins\polyglot\__init__.py:301
msgid "Translate selection"
msgstr "Перекласти вибране"

#: addon\globalPlugins\polyglot\__init__.py:306
msgid "Translate selection (reversed direction)"
msgstr "Перекласти вибране (у зворотному напрямку)"

#: addon\globalPlugins\polyglot\__init__.py:311
msgid "Translate clipboard"
msgstr "Перекласти буфер обміну"

#: addon\globalPlugins\polyglot\__init__.py:314
#: addon\globalPlugins\polyglot\__init__.py:321
msgid "Clipboard is empty"
msgstr "Буфер обміну порожній"

#: addon\globalPlugins\polyglot\__init__.py:318
msgid "Translate clipboard (reversed direction)"
msgstr "Перекласти буфер обміну (у зворотному напрямку)"

#: addon\globalPlugins\polyglot\__init__.py:325
msgid "Translate last spoken text"
msgstr "Перекласти останній промовлений текст"

#: addon\globalPlugins\polyglot\__init__.py:328
#: addon\globalPlugins\polyglot\__init__.py:335
msgid "No last spoken text"
msgstr "Немає останнього промовленого тексту"

#: addon\globalPlugins\polyglot\__init__.py:332
msgid "Translate last spoken text (reversed direction)"
msgstr "Перекласти останній промовлений текст (у зворотному напрямку)"

#: addon\globalPlugins\polyglot\__init__.py:339
msgid "Show command layer help"
msgstr "Показати довідку командного шару"

#: addon\globalPlugins\polyglot\__init__.py:344
msgid "Polyglot Help"
msgstr "Довідка поліглота"

#. Translators: Heading for translation commands in the command-layer help.
#: addon\globalPlugins\polyglot\__init__.py:354
msgid "Translation Actions"
msgstr "Дії перекладу"

#. Translators: Heading for configuration commands in the command-layer help.
#: addon\globalPlugins\polyglot\__init__.py:366
msgid "Configuration & Switching"
msgstr "Конфігурація та перемикання"

#. Translators: Heading for tool commands in the command-layer help.
#: addon\globalPlugins\polyglot\__init__.py:380
msgid "Tools & System"
msgstr "Інструменти та система"

#. Translators: Table column heading for a command-layer key.
#: addon\globalPlugins\polyglot\__init__.py:400
msgid "Key"
msgstr "Комбінація"

#. Translators: Table column heading for a command-layer action.
#: addon\globalPlugins\polyglot\__init__.py:402
msgid "Action"
msgstr "Дія"

#: addon\globalPlugins\polyglot\app\manager.py:109
#: addon\globalPlugins\polyglot\app\manager.py:147
msgid "Invalid engine configuration."
msgstr "Неправильна конфігурація сервісу."

#: addon\globalPlugins\polyglot\app\manager.py:118
msgid "Swap failed: 'Auto-detect' cannot be the target language."
msgstr "Помилка заміни: «Автоматичне визначення» не може бути мовою перекладу."

#. Translators: A message indicating that the source and target languages have been swapped. {source} is the new source language, {target} is the new target language.
#: addon\globalPlugins\polyglot\app\manager.py:123
#, python-brace-format
msgid "Languages swapped: from {source} to {target}"
msgstr "Мови змінено: з {source} на {target}"

#: addon\globalPlugins\polyglot\app\manager.py:167
msgid "No languages available for cycling."
msgstr "Немає мов, доступних для циклічного перемикання."

#: addon\globalPlugins\polyglot\app\manager.py:192
msgid "No translation engines available."
msgstr "Немає доступних сервісів перекладу."

#: addon\globalPlugins\polyglot\app\manager.py:197
#: addon\globalPlugins\polyglot\app\manager.py:349
#: addon\globalPlugins\polyglot\views\interactiveDialog.py:40
#: addon\globalPlugins\polyglot\views\interactiveDialog.py:236
#: addon\globalPlugins\polyglot\views\interactiveDialog.py:272
msgid "No enabled translation engines available."
msgstr "Немає доступних увімкнених сервісів перекладу."

#. Translators: Announcement of the current translation engine and languages. {engine} is the engine name, {source} is the source language, {target} is the target language.
#: addon\globalPlugins\polyglot\app\manager.py:213
#, python-brace-format
msgid "{engine}, from {source} to {target}"
msgstr "{engine}, з {source} на {target}"

#: addon\globalPlugins\polyglot\app\manager.py:222
msgid "Languages not configured or current engine is invalid"
msgstr "Мови не налаштовано або поточний сервіс перекладу недійсний"

#: addon\globalPlugins\polyglot\app\manager.py:267
msgid "Languages not configured, cannot reverse."
msgstr "Мови не налаштовано, неможливо змінити."

#: addon\globalPlugins\polyglot\app\manager.py:273
msgid "Reverse failed: 'Auto-detect' cannot be the target language."
msgstr ""
"Помилка при зворотному перекладі: «Автоматичне визначення» не може бути "
"мовою перекладу."

#: addon\globalPlugins\polyglot\app\manager.py:276
msgid "Current translation engine is invalid."
msgstr "Поточний сервіс перекладу недійсний."

#: addon\globalPlugins\polyglot\app\manager.py:293
msgid "Nothing to translate"
msgstr "Нема чого перекладати"

#: addon\globalPlugins\polyglot\app\manager.py:307
#, python-brace-format
msgid "Error: Selected engine '{engine}' is unavailable or not configured."
msgstr ""
"Помилка: Вибраний сервіс перекладу '{engine}' недоступний або не "
"налаштований."

#. Translators: Error message when the selected translation engine is not configured properly. {engine} is the internal ID of the engine.
#: addon\globalPlugins\polyglot\app\manager.py:379
#, python-brace-format
msgid "Error: Engine '{engine}' is not configured."
msgstr "Помилка: Сервіс перекладу \"{engine}\" не налаштований."

#: addon\globalPlugins\polyglot\app\manager.py:479
msgid "Translation failed: "
msgstr "Помилка перекладу: "

#: addon\globalPlugins\polyglot\app\manager.py:483
msgid "An unknown error occurred"
msgstr "Сталася невідома помилка"

#: addon\globalPlugins\polyglot\app\manager.py:497
msgid "Auto-translation disabled due to repeated failures."
msgstr "Автоматичний переклад вимкнено через повторні помилки."

#: addon\globalPlugins\polyglot\common\cues.py:152
#, python-format
msgid "%d percent"
